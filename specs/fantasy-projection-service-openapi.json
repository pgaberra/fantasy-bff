  "info": {
    "description": "AI player-stat projections for SlapStat. Emits raw NHL-keyed projected stat lines that the BFF maps to the platform's player id and seeds into a user's projection.",
    "title": "fantasy-projection-service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/backtests/latest": {
      "get": {
        "operationId": "latest_backtest_api_v1_backtests_latest_get",
        "parameters": [
          {
            "in": "header",
            "name": "x-internal-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacktestSummaryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Latest Backtest",
        "tags": [
          "projections"
        ]
      }
    },
    "/api/v1/projections/skaters": {
      "get": {
        "operationId": "list_skater_projections_api_v1_projections_skaters_get",
        "parameters": [
          {
            "description": "Target season start year, e.g. 2026",
            "in": "query",
            "name": "season",
            "required": true,
            "schema": {
              "description": "Target season start year, e.g. 2026",
              "title": "Season",
              "type": "integer"
            }
          },
          {
            "description": "Projection model version",
            "in": "query",
            "name": "model_version",
            "required": false,
            "schema": {
              "default": "marcel-v1",
              "description": "Projection model version",
              "title": "Model Version",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-internal-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SkaterProjectionResponse"
                  },
                  "title": "Response List Skater Projections Api V1 Projections Skaters Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Skater Projections",
        "tags": [
          "projections"
        ]
      }
    },
    "/api/v1/projections/skaters/{nhl_id}": {
      "get": {
        "operationId": "get_skater_projection_api_v1_projections_skaters__nhl_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "nhl_id",
            "required": true,
            "schema": {
              "title": "Nhl Id",
              "type": "integer"
            }
          },
          {
            "description": "Target season start year, e.g. 2026",
            "in": "query",
            "name": "season",
            "required": true,
            "schema": {
              "description": "Target season start year, e.g. 2026",
              "title": "Season",
              "type": "integer"
            }
          },
          {
            "description": "Projection model version",
            "in": "query",
            "name": "model_version",
            "required": false,
            "schema": {
              "default": "marcel-v1",
              "description": "Projection model version",
              "title": "Model Version",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-internal-api-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Internal-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkaterProjectionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Skater Projection",
        "tags": [
          "projections"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness probe. Returns {'status': 'UP'} \u2014 same shape as the other services' health.",
