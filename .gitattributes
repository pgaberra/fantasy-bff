# Check every text file out with LF, on every platform. Without this, a Windows checkout gets
# CRLF working copies, and any formatter or generator that rewrites files then shows the whole
# tree as modified with no content change, burying the real diff underneath.
* text=auto eol=lf

/gradlew text eol=lf
*.bat text eol=crlf
*.jar binary

# Keep committed OpenAPI specs LF-normalised so they diff cleanly between
# Windows dev machines and Linux CI runners (the spec drift check uses diff).
specs/*.yaml text eol=lf
